<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal icon variant (plan 19.3).

  The same rising line as the default, with the intermediate nodes removed:
  only the origin dot and the destination remain. Adaptive icons are masked
  to as little as a 66dp circle inscribed in the 108dp canvas, so the path
  is pulled inside the 72dp safe zone rather than reusing the default's
  wider sweep, which a circular mask would clip at both ends.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M36,68 L72,40" />
    <path android:fillColor="#FFC8E9D8" android:pathData="M72,40m-9,0a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z" />
</vector>
