<?xml version="1.0" encoding="utf-8"?>
<!--
  Pill behind a widget check-in button.

  Drawn as a translucent white/black wash rather than an accent fill: the
  accent is not knowable at resource-compile time, and a wash reads
  correctly against every one of the four backgrounds above.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#22808080" />
    <corners android:radius="18dp" />
</shape>
