<?xml version="1.0" encoding="utf-8"?>
<!--
    Generic Compose tab host, matching the structure proven by Studio
    (fragment_studio.xml): an inflated match_parent root whose ComposeView
    fills what remains.

    Why XML rather than constructing the ComposeView in code: a fragment view
    built programmatically reaches the shell without real layout params, and
    inside ViewPager2 that path ends with the composition measured at
    infinite height - which any LazyColumn rejects. Inflation through here
    keeps the params the shell expects.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compose_tab_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
