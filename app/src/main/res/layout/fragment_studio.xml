<?xml version="1.0" encoding="utf-8"?>
<!--
    Studio (11.4): the merged Coach + Blueprint + AI Engine surface.

    The body is Compose; only the toolbar stays a View, because the shell's
    menu, overflow and insets behaviour are already correct here and
    re-implementing them in Compose would be a downgrade for no gain.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SuperFlow.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/tab_studio"
        app:menu="@menu/studio_menu" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
