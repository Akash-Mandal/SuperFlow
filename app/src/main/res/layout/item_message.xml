<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msg_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/msg_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.SuperFlow.Card">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <TextView android:id="@+id/msg_text" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.SuperFlow.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true" />
            <TextView android:id="@+id/msg_meta" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:visibility="gone"
                android:textAppearance="@style/Text.SuperFlow.Overline"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
