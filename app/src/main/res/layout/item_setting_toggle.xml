<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch_min"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/toggle_title" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.SuperFlow.BodyLarge"
            android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/toggle_sub" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:visibility="gone"
            android:textAppearance="@style/Text.SuperFlow.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
