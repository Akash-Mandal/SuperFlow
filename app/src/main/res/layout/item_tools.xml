<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="@dimen/card_gap"
    android:baselineAligned="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tool_1"
        style="@style/Widget.SuperFlow.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">
            <ImageView android:id="@+id/tool_1_icon" android:layout_width="24dp"
                android:layout_height="24dp" app:tint="?attr/colorPrimary" />
            <TextView android:id="@+id/tool_1_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="@style/Text.SuperFlow.LabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tool_2"
        style="@style/Widget.SuperFlow.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">
            <ImageView android:id="@+id/tool_2_icon" android:layout_width="24dp"
                android:layout_height="24dp" app:tint="?attr/colorPrimary" />
            <TextView android:id="@+id/tool_2_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="@style/Text.SuperFlow.LabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tool_3"
        style="@style/Widget.SuperFlow.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">
            <ImageView android:id="@+id/tool_3_icon" android:layout_width="24dp"
                android:layout_height="24dp" app:tint="?attr/colorPrimary" />
            <TextView android:id="@+id/tool_3_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="@style/Text.SuperFlow.LabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
