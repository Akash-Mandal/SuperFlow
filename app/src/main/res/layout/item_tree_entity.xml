<?xml version="1.0" encoding="utf-8"?>
<!--
  One node in the Journey hierarchy.

  Indentation is applied to this outer container at bind time rather than
  declared here, because depth is data. The rail is a plain View whose width
  is set alongside it: a real connector drawing (elbows and tees) would need
  a custom View, and at four levels deep a single vertical rule reads the
  same and costs nothing.

  The chevron is a separate 48dp target from the card. Tapping a system's
  title should open the system; tapping the chevron should open its children.
  Collapsing those two into one gesture is the thing that makes hierarchy
  browsers frustrating.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tree_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical">

    <View
        android:id="@+id/tree_indent"
        android:layout_width="0dp"
        android:layout_height="1dp" />

    <View
        android:id="@+id/tree_rail"
        android:layout_width="@dimen/stroke_hairline"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/entity_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/space_sm"
        android:focusable="true"
        style="@style/Widget.SuperFlow.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/entity_icon_frame"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/space_md"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:id="@+id/entity_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/entity_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="@style/Text.SuperFlow.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/entity_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="@style/Text.SuperFlow.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!--
                The subtree count. Shown only when the node is collapsed and
                has children: an open branch already shows what is in it,
                and a badge repeating that is noise.
            -->
            <TextView
                android:id="@+id/entity_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:visibility="gone"
                android:textAppearance="@style/Text.SuperFlow.Data"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entity_expand"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_min"
                android:minHeight="@dimen/touch_min"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_down"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entity_menu"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_min"
                android:minHeight="@dimen/touch_min"
                app:icon="@drawable/ic_more"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
