<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="18dp">
    <TextView android:id="@+id/step_kicker" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.SuperFlow.Overline"
        android:textColor="?attr/colorPrimary" />
    <TextView android:id="@+id/step_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textAppearance="@style/Text.SuperFlow.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/step_body" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textAppearance="@style/Text.SuperFlow.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
