    <item android:id="@+id/nav_journey" android:icon="@drawable/ic_journey" android:title="@string/tab_journey" />
    <item android:id="@+id/nav_insights" android:icon="@drawable/ic_insights" android:title="@string/tab_insights" />
    <item android:id="@+id/nav_studio" android:icon="@drawable/ic_sparkle" android:title="@string/tab_studio" />
</menu>
