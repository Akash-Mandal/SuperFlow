        <item name="colorPrimaryContainer">@color/sf_mono_stone_30</item>
        <item name="colorOnPrimaryContainer">@color/sf_mono_stone_90</item>
        <item name="colorPrimaryInverse">@color/sf_mono_stone_50</item>

        <item name="colorSecondary">@color/sf_mono_stone_80</item>
