<?xml version="1.0" encoding="utf-8"?>
<!--
  SuperFlow Material 3 theme.

  Built on Theme.Material3.DayNight.NoActionBar so every Material component
  picks up the correct tonal surfaces, ripples, shape and typography without
  per-widget styling.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SuperFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/sf_green_50</item>
        <item name="colorOnPrimary">@color/sf_neutral_100</item>
        <item name="colorPrimaryContainer">@color/sf_green_90</item>
        <item name="colorOnPrimaryContainer">@color/sf_green_10</item>
        <item name="colorPrimaryInverse">@color/sf_green_80</item>

        <!-- Secondary -->
        <!-- Tone 40, not 50: white text on amber 50 is 3.95:1, under AA.
             See the note in themes_palette.xml; RoleTest enforces it. -->
        <item name="colorSecondary">@color/sf_amber_40</item>
        <item name="colorOnSecondary">@color/sf_neutral_100</item>
        <item name="colorSecondaryContainer">@color/sf_amber_90</item>
        <item name="colorOnSecondaryContainer">@color/sf_amber_10</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/sf_indigo_40</item>
        <item name="colorOnTertiary">@color/sf_neutral_100</item>
        <item name="colorTertiaryContainer">@color/sf_indigo_90</item>
        <item name="colorOnTertiaryContainer">#FF0E1B33</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/sf_neutral_98</item>
        <item name="colorOnBackground">@color/sf_neutral_10</item>
        <item name="colorSurface">@color/sf_neutral_100</item>
        <item name="colorOnSurface">@color/sf_neutral_10</item>
        <item name="colorSurfaceVariant">@color/sf_neutral_94</item>
        <item name="colorOnSurfaceVariant">@color/sf_neutral_40</item>
        <item name="colorSurfaceInverse">@color/sf_neutral_20</item>
        <item name="colorOnSurfaceInverse">@color/sf_neutral_96</item>
        <item name="colorOutline">@color/sf_neutral_70</item>
        <item name="colorOutlineVariant">@color/sf_neutral_90</item>

        <item name="colorError">@color/sf_error_40</item>
        <item name="colorOnError">@color/sf_neutral_100</item>
        <item name="colorErrorContainer">@color/sf_error_90</item>
        <item name="colorOnErrorContainer">#FF3B0F09</item>

        <!-- System bars: edge to edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <!-- Shape -->
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.SuperFlow.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.SuperFlow.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.SuperFlow.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.SuperFlow.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.SuperFlow.ExtraLarge</item>

        <!-- Type -->
        <item name="textAppearanceDisplaySmall">@style/Text.SuperFlow.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/Text.SuperFlow.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/Text.SuperFlow.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/Text.SuperFlow.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Text.SuperFlow.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Text.SuperFlow.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Text.SuperFlow.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/Text.SuperFlow.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/Text.SuperFlow.LabelMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/Text.SuperFlow.HeadlineLarge</item>
        <item name="textAppearanceDisplayMedium">@style/Text.SuperFlow.Display</item>

        <!-- Semantic tokens (§6.4). Layouts reference intent, not literals,
             so a palette overlay can retheme these in one place. -->
        <item name="sfSuccess">@color/sf_success</item>
        <item name="sfOnSuccess">@color/sf_on_success</item>
        <item name="sfSuccessContainer">@color/sf_success_container</item>
        <item name="sfWarning">@color/sf_warning</item>
        <item name="sfOnWarning">@color/sf_on_warning</item>
        <item name="sfWarningContainer">@color/sf_warning_container</item>
        <item name="sfCaution">@color/sf_caution</item>
        <item name="sfCautionContainer">@color/sf_caution_container</item>
        <item name="sfInfo">@color/sf_info</item>
        <item name="sfInfoContainer">@color/sf_info_container</item>
        <item name="sfRecovery">@color/sf_recovery</item>
        <item name="sfRecoveryContainer">@color/sf_recovery_container</item>
        <item name="sfCelebration">@color/sf_celebration</item>
        <item name="sfCelebrationContainer">@color/sf_celebration_container</item>

        <item name="sfEnergy1">@color/sf_energy_1</item>
        <item name="sfEnergy2">@color/sf_energy_2</item>
        <item name="sfEnergy3">@color/sf_energy_3</item>
        <item name="sfEnergy4">@color/sf_energy_4</item>
        <item name="sfEnergy5">@color/sf_energy_5</item>

        <item name="sfLevelTiny">@color/level_tiny</item>
        <item name="sfLevelMinimum">@color/level_minimum</item>
        <item name="sfLevelStandard">@color/level_standard</item>
        <item name="sfLevelStretch">@color/level_stretch</item>

        <item name="sfStateSkipped">@color/state_skipped</item>
        <item name="sfStateMissed">@color/state_missed</item>
        <item name="sfStateEmpty">@color/state_empty</item>

        <!-- Entity accents (§6.5). Follow the palette's own roles so they
             recolour automatically when the palette changes. -->
        <item name="sfAccentIdentity">?attr/colorPrimary</item>
        <item name="sfAccentGoal">?attr/colorSecondary</item>
        <item name="sfAccentSystem">?attr/colorTertiary</item>
        <item name="sfAccentHabit">?attr/colorOutline</item>

        <item name="sfSkeletonBase">@color/sf_skeleton_base</item>
        <item name="sfSkeletonHighlight">@color/sf_skeleton_highlight</item>

        <!-- Density: Comfortable defaults (§4.2). Overridden wholesale by
             the ThemeOverlay.SuperFlow.Density.* overlays. -->
        <item name="sfCardPadding">20dp</item>
        <item name="sfListItemHeight">56dp</item>
        <item name="sfCardGap">12dp</item>
        <item name="sfSectionSpacing">24dp</item>
        <item name="sfLineSpacing">1.25</item>

        <!-- Default border weight. The high-contrast overlay raises this. -->
        <item name="sfCardStrokeWidth">1dp</item>
        <item name="sfDividerColor">@color/sf_neutral_90</item>

        <item name="sfSerifFontFamily">@font/source_serif</item>

        <!-- Default face for any view that does not set a textAppearance. -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- Component defaults -->
        <item name="materialCardViewStyle">@style/Widget.SuperFlow.Card</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SuperFlow.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.SuperFlow.Dialog</item>
        <item name="chipStyle">@style/Widget.SuperFlow.Chip</item>

        <!-- Motion -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="Theme.SuperFlow.Splash" parent="Theme.SuperFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Bottom sheets get a large top-corner radius and no dim overload -->
    <style name="Theme.SuperFlow.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SuperFlow.BottomSheet</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.SuperFlow.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/Shape.SuperFlow.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="behavior_peekHeight">560dp</item>
    </style>

    <style name="Theme.SuperFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.SuperFlow.Dialog</item>
    </style>

</resources>
